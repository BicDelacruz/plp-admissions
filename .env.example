# PLP Admissions — Environment
# Copy this file to .env and fill in your values.
# This file should NEVER be committed to Git.
# On Vercel, set these as Project Environment Variables instead of a .env file.
# Sample values only. Do not put real secrets in this file.

# App
# APP_ENV=production on Vercel turns on DB-backed sessions and uses APP_URL.
APP_ENV=development
APP_URL=https://your-app.vercel.app

# Database (Supabase Postgres, transaction pooler)
# DB_USER needs the project ref: postgres.<project ref>
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASS=your-database-password
# DB_SSLMODE=require

# Supabase Storage (server side only, never expose the service key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Bucket names default to documents and branding. Set only if yours differ.
# SUPABASE_BUCKET_DOCUMENTS=documents
# SUPABASE_BUCKET_BRANDING=branding

# Cloudflare Turnstile (https://dash.cloudflare.com > Turnstile). Leave empty to turn the captcha off.
# Local testing: use Cloudflare's dummy keys (site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA = always pass).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google sign in (https://console.cloud.google.com > APIs & Services > Credentials). Leave empty to hide the button.
# Authorized redirect URIs: https://plp-admissions.vercel.app/auth/google/callback and http://localhost:8000/public/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Leave empty: the callback URL is built from the site address you open (https://<your-domain>/auth/google/callback).
# Set it only to force one exact URL; it must match an authorized redirect URI in Google Cloud.
GOOGLE_REDIRECT_URI=

# Email (Gmail SMTP — use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=PLP Admissions

# AI document sorting (model runs on the team PC, reached through the Cloudflare Tunnel)
# Leave AI_MODEL_URL empty to turn AI off; uploads then use the category dropdown.
AI_MODEL_URL=https://your-tunnel-hostname.example.com
AI_TIMEOUT=25
AI_MODEL_KEY=same-value-as-ai.env

# Enrollment handoff. Accepted applicants who confirm are sent here.
# URL is the enrollment site receiver. The secret must equal ADMISSION_HANDOFF_SECRET in the enrollment project.
# Generate with: openssl rand -hex 32
ENROLLMENT_HANDOFF_URL=https://your-enrollment-site.vercel.app/api/integration/admissions/handoff
ENROLLMENT_HANDOFF_SECRET=
# Optional. When set, confirmed applicants see a "Go to Enrollment" button on their result page.
# Set it only once the registrar can create student accounts, or students will have no login yet.
ENROLLMENT_SITE_URL=
